{
  "name": "hoot-hollow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hoot Hollow: a cozy gamified sleep tracker with an owl who goes on adventures while you sleep.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "vite build --mode artifact",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/nunito": "^5.1.0",
    "@fontsource/pixelify-sans": "^5.1.0",
    "@fontsource/silkscreen": "^5.1.0",
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/three": "0.170.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
